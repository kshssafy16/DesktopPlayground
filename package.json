{
  "name": "desktopplayground",
  "productName": "DesktopPlayground",
  "version": "1.1.0",
  "description": "Interactive desktop pets and playground for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.desktopplayground.app",
    "productName": "DesktopPlayground",
    "directories": {
      "buildResources": "electron-build",
      "output": "dist-beta"
    },
    "files": [
      "main.js",
      "taskbar-zorder.ps1",
      "local-pets.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "screen-effects.js",
      "animation/pet-animation.cjs",
      "animation/profiles.browser.js",
      "styles.css",
      "controls.html",
      "controls.js",
      "controls.css",
      "spritesheet.webp",
      "spritesheet_2.webp",
      "assets/icon.png",
      "assets/tools/hammer.png",
      "assets/tools/bomb.png",
      "assets/weapons/awm.png",
      "assets/weapons/ak47.png",
      "assets/weapons/uzi.png",
      "assets/weapons/double_barrel.png",
      "assets/pets/doge/pet.json",
      "assets/pets/doge/spritesheet.webp",
      "assets/pets/kirby/pet.json",
      "assets/pets/kirby/spritesheet.webp",
      "package.json",
      "assets/pets/cat_brown/pet.json",
      "assets/pets/cat_brown/spritesheet.webp",
      "assets/pets/cat_face/pet.json",
      "assets/pets/cat_face/spritesheet.webp",
      "assets/pets/cat_sleepy/pet.json",
      "assets/pets/cat_sleepy/spritesheet.webp",
      "assets/pets/kirby_sleepy/pet.json",
      "assets/pets/kirby_sleepy/spritesheet.webp",
      "assets/pets/puddle/pet.json",
      "assets/pets/puddle/spritesheet.webp",
      "assets/pets/salary-cat/pet.json",
      "assets/pets/salary-cat/spritesheet.webp",
      "assets/pets/usagi/pet.json",
      "assets/pets/usagi/spritesheet.webp",
      "assets/pets/call_duck/pet.json",
      "assets/pets/call_duck/spritesheet.webp",
      "assets/pets/baby_harp_seal/pet.json",
      "assets/pets/baby_harp_seal/spritesheet.webp",
      "animation/**",
      "assets/weapons/*.png",
      "assets/tools/*.png",
      "assets/tools/ui-*.svg"
    ],
    "win": {
      "icon": "electron-build/icon.ico",
      "executableName": "DesktopPlayground",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DesktopPlayground.exe"
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0"
  }
}
