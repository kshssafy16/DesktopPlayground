{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktopplayground.local/animation/profile-authoring.schema.json",
  "title": "DesktopPlayground sprite pet animation profile",
  "description": "Authoring-time shape for one profiles.v1.json entry; this file is not a runtime loader.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows", "origin", "elasticity", "sleeping", "clips", "fallback"],
  "properties": {
    "rows": {"type": "integer", "minimum": 1},
    "origin": {"enum": ["feet", "center"]},
    "elasticity": {"type": "number", "minimum": 0, "maximum": 1},
    "sleeping": {"type": "boolean"},
    "clips": {
      "type": "object",
      "minProperties": 1,
      "required": ["idle"],
      "additionalProperties": {"$ref": "#/$defs/clip"}
    },
    "fallback": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": {"$ref": "#/$defs/unit"},
        "foot": {"$ref": "#/$defs/unit"},
        "centerY": {"$ref": "#/$defs/unit"},
        "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "offsetX": {"type": "number", "minimum": -0.5, "maximum": 0.5},
        "offsetY": {"type": "number", "minimum": -0.5, "maximum": 0.5}
      }
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "frames", "frameMs"],
      "properties": {
        "row": {"type": "integer", "minimum": 0},
        "frames": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 7}},
        "frameMs": {"type": "number", "exclusiveMinimum": 0},
        "loop": {"type": "boolean"},
        "flip": {"type": "boolean"},
        "mirrorOf": {"type": "string", "minLength": 1},
        "center": {"$ref": "#/$defs/unit"},
        "centerY": {"$ref": "#/$defs/unit"},
        "foot": {"$ref": "#/$defs/unit"},
        "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "tilt": {"type": "number"},
        "bob": {"type": "number"},
        "bobMs": {"type": "number", "exclusiveMinimum": 0},
        "frameAdjustments": {
          "type": "object",
          "patternProperties": {"^[0-7]$": {"$ref": "#/$defs/adjustment"}},
          "additionalProperties": false
        }
      }
    }
  }
}
